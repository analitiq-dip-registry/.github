{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "api",
  "connector_id": "sevdesk",
  "display_name": "sevdesk",
  "description": "Cloud-based accounting and invoicing platform for small businesses and freelancers in the DACH region.",
  "documentation_url": "https://api.sevdesk.de/",
  "tags": [
    "accounting",
    "invoicing",
    "finance",
    "dach",
    "api"
  ],
  "version": "4.0.1",
  "default_transport": "api",
  "transports": {
    "api": {
      "transport_type": "http",
      "base_url": "https://my.sevdesk.de/api/v1",
      "headers": {
        "Accept": "application/json",
        "Authorization": {
          "template": "${secrets.api_token}"
        }
      },
      "timeout_seconds": 30
    }
  },
  "auth": {
    "type": "api_key"
  },
  "connection_contract": {
    "inputs": {
      "api_token": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "API Token",
          "widget": "password",
          "help_text": "32-character hexadecimal token from my.sevdesk.de under Extensions (Erweiterungen) > API (reveal with your account password)."
        }
      }
    },
    "post_auth_outputs": {
      "bookkeeping_system_version": {
        "mode": "auto_discovery",
        "storage": "connection.discovered",
        "type": "string",
        "value_path": "objects.version",
        "discovery_request": {
          "transport_ref": "api",
          "method": "GET",
          "path": "/Tools/bookkeepingSystemVersion"
        }
      }
    }
  }
}
